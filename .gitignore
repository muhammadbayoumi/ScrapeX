# ── Secrets & credentials — NEVER commit ───────────────────────────────
client_secret.json
token.json
*.secret
.env
.env.*
credentials/
google/

# ── Local data (the warehouse, exports, inbox live in ~/.scrapex) ──────
*.db
*.db-wal
*.db-shm
*.sqlite
*.xlsx
harvest.db*
/out/

# ── Python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ── OS / editors ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
# Visual Studio's own workspace state: .vsidx indexes run to tens of megabytes
# each and are per-machine. Untracked was not enough -- `git add -A` swept 33 MB
# of them into a commit on 2026-08-20, which is the SR-19 failure the rule names.
.vs/

# screenshot harness scratch
docs/screenshots/_tmp/
# and the per-suite scratch engine_verify.py writes beside its output
docs/screenshots/*/_tmp/

# ── Claude Code ────────────────────────────────────────────────────────
# Worktrees are complete nested checkouts — never commit one. This rule used
# to live in .git/info/exclude, which git does not transmit, so it existed on
# one machine only and `git add .` on the other would have committed an entire
# nested repository. Note .claude/skills/ IS tracked, deliberately.
.claude/worktrees/
