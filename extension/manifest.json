{
  "manifest_version": 3,
  "name": "ScrapeX",
  "key": "",
  "version": "0.2.1",
  "description": "A local scraping tool: capture prices from the sites you browse into a warehouse on your own machine.",
  "icons": {
    "16": "icons/x-mark-original-16.png",
    "32": "icons/x-mark-original-32.png",
    "48": "icons/x-mark-original-48.png",
    "128": "icons/x-mark-original-128.png"
  },
  "action": {
    "default_title": "Open ScrapeX",
    "default_icon": {
      "16": "icons/x-mark-original-16.png",
      "32": "icons/x-mark-original-32.png"
    }
  },
  "side_panel": {
    "default_path": "app.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "identity",
    "nativeMessaging",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://raw.githubusercontent.com/muhammadbayoumi/mbiX-hub/*",
    "https://www.googleapis.com/oauth2/v3/*"
  ],
  "oauth2": {
    "client_id": "668111083414-0fd7tso17orbbqrkg0mjnne8oig0pqru.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
